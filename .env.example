# Copy this file to .env.local (git-ignored) and fill in the values.
# Both the Next.js app and the backend scripts read .env.local from the repo root.
# On Vercel, set the same variables in Project Settings > Environment Variables.

# Required. Postgres connection string. For Neon, use the pooled connection string
# (host contains "-pooler") and keep ?sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/updates?sslmode=require

# Required. Protects /api/cron/fetch. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>"; use the same header to trigger a fetch by hand.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-a-long-random-string

# Required in production. Public base URL, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. IANA timezone that decides where one archive day ends and the next begins,
# and how dates are shown. Postgres must know the zone (Neon does); the embedded local
# Postgres from pgserver only knows UTC.
APP_TIMEZONE=UTC

# Optional. When set, /api/cron/enrich (daily at 08:00 UTC, or `npm run enrich`) gives
# new items a short AI summary and topic tags from the Claude API. Leave empty to keep
# keyword tagging and each source's own summary. This spends money on your Anthropic
# account; see the README for a cost estimate.
ANTHROPIC_API_KEY=

# Optional. Claude model for summaries. Default: claude-opus-5. A cheaper model such as
# claude-sonnet-5 or claude-haiku-4-5 cuts the cost further.
AI_MODEL=

# Optional. Most items processed per run (default 100). News, articles and community
# items go first; papers after, since they already carry an abstract.
AI_MAX_ITEMS_PER_RUN=
